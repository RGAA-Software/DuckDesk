#!/usr/bin/env bash
set -euo pipefail

if [[ "${PIXELS_PG_ISOLATED_TEST:-}" != 1 || ! "${PIXELS_TEST_CONTAINER:-}" =~ ^[a-f0-9]{12,64}$ ]]; then
    echo "isolated PostgreSQL container is required" >&2
    exit 2
fi
archive_path=
database_name=
while [[ $# -gt 0 ]]; do
    case "$1" in
        --file|--dbname)
            [[ $# -ge 2 ]] || exit 2
            if [[ "$1" == --file ]]; then archive_path=$2; else database_name=$2; fi
            shift 2
            ;;
        --format=custom|--no-password)
            shift
            ;;
        --host|--port|--username)
            [[ $# -ge 2 ]] || exit 2
            shift 2
            ;;
        *)
            echo "unexpected pg_dump argument" >&2
            exit 2
            ;;
    esac
done
[[ -n "$archive_path" && "$database_name" == pixels_console ]] || exit 2
docker exec -i "$PIXELS_TEST_CONTAINER" pg_dump --format=custom --no-password --username pixels_admin --dbname "$database_name" >"$archive_path"
