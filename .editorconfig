root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 150

[*.{cpp,cxx,cc,h,hpp,hxx,inl}]
indent_style = space
indent_size = 4
max_line_length = 80

[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100
end_of_line = lf

[*.{ts,tsx,mts,cts}]
indent_style = space
indent_size = 4
max_line_length = 100
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
