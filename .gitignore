# Windows reserved device name artifact (can't be indexed by git)
nul

# Message protos are generated at build time from src/px_deps/px_message_new
# (single source of truth); the web clients' copies are synced, never committed.
src/px_web_client/proto/*.proto
web/px_web_client/proto/*.proto


# rustdesk upstream reference clone (read-only reference for the ft rewrite)
rustdesk/

# local test scripts/logs/screenshots and remote-admin credentials (never commit)
# NOTE: anchored to repo root only — nested tests/ dirs (e.g. px_deps/*/tests) stay tracked
/tests/*
!/tests/webview_e2e/
!/tests/webview_e2e/index.html
