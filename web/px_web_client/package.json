{
  "name": "px-web-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/sync_web_protos.mjs",
    "prebuild": "node ../../scripts/sync_web_protos.mjs",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build-only": "vite build",
    "preview": "vite preview",
    "test": "npm run test:voice && npm run test:unit",
    "test:unit": "vitest run",
    "test:rtc": "vitest run test/standard_signaling.test.ts test/stats.test.ts",
    "test:voice": "node test/voice_call_state_test.mjs"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.46.0",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "element-plus": "^2.11.4",
    "fflate": "^0.8.3",
    "protobufjs": "^8.7.1",
    "vue": "^3.5.22",
    "vue-i18n": "^11.4.8"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.0",
    "vite": "^7.1.11",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
