1 VERSIONINFO
 FILEVERSION @PX_PRODUCT_VERSION_MAJOR@, @PX_PRODUCT_VERSION_MINOR@, @PX_PRODUCT_VERSION_PATCH@
 PRODUCTVERSION @PX_PRODUCT_VERSION_MAJOR@, @PX_PRODUCT_VERSION_MINOR@, @PX_PRODUCT_VERSION_PATCH@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040004b0"
        BEGIN
            VALUE "CompanyName", "@PX_PRODUCT_COMPANY@"
            VALUE "FileDescription", "@PX_PRODUCT_DISPLAY_NAME@"
            VALUE "FileVersion", "@PX_PRODUCT_VERSION@"
            VALUE "InternalName", "px_panel.exe"
            VALUE "LegalCopyright", "Copyright (c) 2022-2026 @PX_PRODUCT_COMPANY@"
            VALUE "OriginalFilename", "px_panel.exe"
            VALUE "ProductName", "@PX_PRODUCT_DISPLAY_NAME@"
            VALUE "ProductVersion", "@PX_PRODUCT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x400, 1200
    END
END

IDI_ICON1 ICON "icon.ico"
