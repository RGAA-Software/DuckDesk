scripts_build/*.bat text eol=crlf
# Archived originals must retain exact bytes so their SHA-256 manifests survive checkout.
backup/** -text
# Isolated iroh crate and reviewed patches have byte-exact SHA-256 manifests.
rust_transport/vendor/** -text
patches/iroh/*.patch -text
# The pinned NSIS toolchain is a verbatim upstream/vendor bundle with binary plug-ins.
tools/nsis/** binary
# Keep the source-dependency fingerprint identical on all developer machines.
third_party/freerdp/vcpkg.json text eol=lf
deploy/development/postgres/*.sh text eol=lf
deploy/development/postgres/*.yaml text eol=lf
deploy/single_server/linux/*.sh text eol=lf
deploy/relay/*.py text eol=lf
deploy/relay/*.yaml text eol=lf
scripts_build/build_px_relay_server.sh text eol=lf
scripts_build/package_px_relay_linux.sh text eol=lf
scripts_build/build_postgresql_client_toolchain.sh text eol=lf
scripts_build/build_single_server_linux_image.sh text eol=lf
rust_server/px_*_server/migrations/*.sql text eol=lf
rust_server/px_console_server/storage/queries/*.sql text eol=lf
rust_server/px_console_server/storage/.sqlx/*.json text eol=lf
rust_server/px_desk_server/queries/*.sql text eol=lf
rust_server/px_desk_server/.sqlx/*.json text eol=lf
rust_server/px_auth_server/storage/queries/*.sql text eol=lf
rust_server/px_auth_server/storage/.sqlx/*.json text eol=lf
scripts/server_validation/*.sh text eol=lf
