  "query": "SELECT n.id,n.device_id,n.product,n.revision,n.generation,n.control_epoch,n.state,n.draining,n.disabled,n.max_instances,n.report_sequence,n.last_seen,n.product_version_code,n.public_host,n.desktop_port,n.application_port_start,n.application_port_end,n.game_hook,n.webview,n.rdp,n.endpoint_revision,(n.connection_hash IS NOT NULL AND NOT n.disabled AND n.deleted_at IS NULL AND n.control_epoch=(SELECT epoch FROM pixels.control_runtime) AND n.last_seen>clock_timestamp()-interval '30 seconds') AS \"fresh!\" FROM pixels.nodes n WHERE n.id=$1 AND n.deleted_at IS NULL FOR UPDATE OF n\n",
