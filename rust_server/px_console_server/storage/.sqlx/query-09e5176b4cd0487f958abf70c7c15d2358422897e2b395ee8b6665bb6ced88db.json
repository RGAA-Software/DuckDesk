  "db_name": "PostgreSQL",
  "query": "INSERT INTO pixels.application_deployments AS d(\r\n id,application_id,node_id,kind,gpu_key,\r\n capacity,disabled,application_revision)\r\nSELECT $1,a.id,n.id,$4,$5,$6,$7,a.revision FROM pixels.applications a,pixels.nodes n,pixels.devices v\r\nWHERE a.id=$2 AND n.id=$3 AND a.kind=$4 AND a.deleted_at IS NULL AND n.deleted_at IS NULL\r\nAND v.id=n.device_id AND v.deleted_at IS NULL\r\nRETURNING d.id,d.application_id,d.node_id,d.kind,d.gpu_key,d.capacity,d.disabled,d.revision,d.application_revision,d.observed_state,d.observed_reason,d.observed_generation,d.observed_epoch,d.observed_endpoint_revision,d.observed_sequence,d.observed_at\r\n",
