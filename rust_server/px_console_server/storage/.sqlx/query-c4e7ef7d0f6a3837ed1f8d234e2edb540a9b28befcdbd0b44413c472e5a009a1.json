{
  "db_name": "PostgreSQL",
  "query": "SELECT d.id,\r\n       d.application_id,\r\n       d.kind,\r\n       a.executable_path,\r\n       d.gpu_key,\r\n       d.disabled,\r\n       d.revision AS deployment_revision,\r\n       d.application_revision\r\nFROM pixels.application_deployments d\r\nJOIN pixels.applications a ON a.id = d.application_id\r\nWHERE d.node_id = $1\n  AND a.deleted_at IS NULL\n  AND ($2::uuid IS NULL OR d.id > $2)\r\nORDER BY d.id\r\nLIMIT $3\r\n",
